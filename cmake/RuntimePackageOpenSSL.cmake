# FindOpenSSL commonly publishes a Windows import archive as UNKNOWN_LIBRARY.
# Resolve its recorded import DLL relative to the selected library installation.
function(GargantuanOpenSslRuntimeForLibrary Library Output)
	set(${Output} "" PARENT_SCOPE)
	if(NOT EXISTS "${Library}")
		return()
	endif()
	if(Library MATCHES "\\.[dD][lL][lL]$")
		set(${Output} "${Library}" PARENT_SCOPE)
		return()
	endif()
	file(STRINGS "${Library}" DllNames REGEX "^[lL][iI][bB][cC][rR][yY][pP][tT][oO]-3([-_][A-Za-z0-9_]+)?\\.[dD][lL][lL]$")
	list(REMOVE_DUPLICATES DllNames)
	list(LENGTH DllNames DllCount)
	if(DllCount EQUAL 0)
		return() # A static archive has no libcrypto import DLL.
	endif()
	if(NOT DllCount EQUAL 1)
		message(FATAL_ERROR "The selected OpenSSL import archive names multiple libcrypto DLLs")
	endif()
	get_filename_component(LibraryDirectory "${Library}" DIRECTORY)
	find_file(DllPath NAMES ${DllNames}
		PATHS "${LibraryDirectory}" "${LibraryDirectory}/../bin" "${OPENSSL_INCLUDE_DIR}/../bin"
		NO_DEFAULT_PATH NO_CACHE)
	if(NOT DllPath)
		message(FATAL_ERROR "The OpenSSL import archive requires ${DllNames}, which was not found in its installation")
	endif()
	set(${Output} "${DllPath}" PARENT_SCOPE)
endfunction()

set(GARGANTUAN_RUNTIME_PACKAGE_OPENSSL_DLL "")
if(WIN32)
	get_target_property(CryptoTargetType OpenSSL::Crypto TYPE)
	if(CryptoTargetType STREQUAL "SHARED_LIBRARY")
		set(GARGANTUAN_RUNTIME_PACKAGE_OPENSSL_DLL "$<TARGET_FILE:OpenSSL::Crypto>")
	elseif(CryptoTargetType STREQUAL "UNKNOWN_LIBRARY")
		get_target_property(CryptoLibrary OpenSSL::Crypto IMPORTED_LOCATION)
		get_target_property(CryptoReleaseLibrary OpenSSL::Crypto IMPORTED_LOCATION_RELEASE)
		get_target_property(CryptoDebugLibrary OpenSSL::Crypto IMPORTED_LOCATION_DEBUG)
		if(NOT CryptoReleaseLibrary)
			set(CryptoReleaseLibrary "${CryptoLibrary}")
		endif()
		if(NOT CryptoDebugLibrary)
			set(CryptoDebugLibrary "${CryptoReleaseLibrary}")
		endif()
		GargantuanOpenSslRuntimeForLibrary("${CryptoReleaseLibrary}" CryptoReleaseDll)
		GargantuanOpenSslRuntimeForLibrary("${CryptoDebugLibrary}" CryptoDebugDll)
		if(CryptoReleaseDll OR CryptoDebugDll)
			set(GARGANTUAN_RUNTIME_PACKAGE_OPENSSL_DLL "$<IF:$<CONFIG:Debug>,${CryptoDebugDll},${CryptoReleaseDll}>")
		endif()
	endif()
endif()

set(GARGANTUAN_RUNTIME_PACKAGE_OPENSSL_NOTICE "${CMAKE_CURRENT_SOURCE_DIR}/cmake/notices/OpenSSL3.txt")
if(DEFINED VCPKG_INSTALLED_DIR AND DEFINED VCPKG_TARGET_TRIPLET)
	set(OpenSslVcpkgNotice "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/share/openssl/copyright")
	if(EXISTS "${OpenSslVcpkgNotice}")
		set(GARGANTUAN_RUNTIME_PACKAGE_OPENSSL_NOTICE "${OpenSslVcpkgNotice}")
	endif()
endif()
