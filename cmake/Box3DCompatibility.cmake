# Box3D remains pinned and untouched. Build a private copy with the one
# b3LoadV alignment correction required by UBSan on 4-byte-aligned b3Vec3.
# Pinned submodule: 8441b4a06d6d09dcfb0b0f704df4d847d1437b92.
function(GargantuanPrepareBox3DCompatibility SourceDirectory OutputVariable)
	set(SourceSimd "${SourceDirectory}/src/simd.h")
	if(NOT EXISTS "${SourceDirectory}/CMakeLists.txt" OR NOT EXISTS "${SourceSimd}")
		message(FATAL_ERROR "Box3D compatibility requires the pinned source tree")
	endif()
	# file(READ) alone does not make Ninja/Make rerun this hash guard after a
	# submodule update. Track the unpatched input as a configure dependency.
	set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${SourceSimd}")

	# Git's LF blob and Windows' CRLF checkout are the only accepted byte forms.
	file(SHA256 "${SourceSimd}" RawSha256)
	set(ExpectedLfSha256 "688fef3ccbbda3f0923ab5a227bf143408ae02aefa63f79ffbb1798ec71c37b4")
	set(ExpectedCrlfSha256 "ceab82f8c72fe58dc74f2ba0c8db1f721a793a859fc9da3cf058a18028bbfd62")
	if(NOT RawSha256 STREQUAL ExpectedLfSha256 AND NOT RawSha256 STREQUAL ExpectedCrlfSha256)
		message(FATAL_ERROR "Unknown Box3D src/simd.h SHA256 ${RawSha256}; compatibility patch refused")
	endif()
	file(READ "${SourceSimd}" SimdSource)
	string(REPLACE "\r\n" "\n" SimdCanonical "${SimdSource}")
	string(SHA256 CanonicalSha256 "${SimdCanonical}")
	if(NOT CanonicalSha256 STREQUAL ExpectedLfSha256)
		message(FATAL_ERROR "Box3D src/simd.h canonical LF hash mismatch; compatibility patch refused")
	endif()

	set(PrivateSource "${CMAKE_CURRENT_BINARY_DIR}/box3d-compat-source")
	file(GLOB_RECURSE Box3DInputFiles LIST_DIRECTORIES false RELATIVE "${SourceDirectory}"
		"${SourceDirectory}/src/*" "${SourceDirectory}/include/*")
	list(APPEND Box3DInputFiles "CMakeLists.txt")
	foreach(RelativePath IN LISTS Box3DInputFiles)
		if(RelativePath STREQUAL "src/simd.h")
			continue()
		endif()
		get_filename_component(RelativeDirectory "${RelativePath}" DIRECTORY)
		file(MAKE_DIRECTORY "${PrivateSource}/${RelativeDirectory}")
		configure_file("${SourceDirectory}/${RelativePath}" "${PrivateSource}/${RelativePath}" COPYONLY)
	endforeach()

	set(OldLoad "__m128 xy = _mm_castpd_ps( _mm_load_sd( (const double*)( src ) ) );")
	set(NewLoad "double xyBits;\n\tmemcpy( &xyBits, src, sizeof( xyBits ) );\n\t__m128 xy = _mm_castpd_ps( _mm_load_sd( &xyBits ) );")
	string(FIND "${SimdCanonical}" "${OldLoad}" LoadLocation)
	if(LoadLocation EQUAL -1)
		message(FATAL_ERROR "Pinned Box3D SIMD load site changed; compatibility patch refused")
	endif()
	string(REPLACE "${OldLoad}" "${NewLoad}" PatchedSimd "${SimdCanonical}")
	string(REPLACE "#include <stdbool.h>" "#include <stdbool.h>\n#include <string.h>" PatchedSimd "${PatchedSimd}")
	set(PrivateSimd "${PrivateSource}/src/simd.h")
	set(WritePatchedSimd TRUE)
	if(EXISTS "${PrivateSimd}")
		file(READ "${PrivateSimd}" ExistingSimd)
		if(ExistingSimd STREQUAL PatchedSimd)
			set(WritePatchedSimd FALSE)
		endif()
	endif()
	if(WritePatchedSimd)
		file(WRITE "${PrivateSimd}" "${PatchedSimd}")
	endif()
	set(${OutputVariable} "${PrivateSource}" PARENT_SCOPE)
endfunction()
