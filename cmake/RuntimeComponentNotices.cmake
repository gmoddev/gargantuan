# The runtime format closes the set of notice paths. Keep nested credits with
# their parent library so native packaging and relocation preserve them.
function(GargantuanAppendNoticeExcerpt Output Title Input First Last)
	file(READ "${Input}" Body)
	string(FIND "${Body}" "${First}" Begin)
	if(Begin LESS 0)
		message(FATAL_ERROR "Review changed ${Title} notice in ${Input}")
	endif()
	string(SUBSTRING "${Body}" ${Begin} -1 Body)
	string(FIND "${Body}" "${Last}" End)
	if(End LESS 0)
		message(FATAL_ERROR "Incomplete ${Title} notice in ${Input}")
	endif()
	string(SUBSTRING "${Body}" 0 ${End} Excerpt)
	file(APPEND "${Output}" "\n\n${Title}\n\n${Excerpt}\n")
endfunction()

function(GargantuanWriteComponentNotices Directory)
	set(Sdl "${GARGANTUAN_SOURCE_DIR}/vendor/sdl")
	set(SdlNotice "${Directory}/SDL3.txt")
	file(COPY_FILE "${Sdl}/LICENSE.txt" "${SdlNotice}")
	GargantuanAppendNoticeExcerpt("${SdlNotice}" "X.Org keysym translation" "${Sdl}/src/events/imKStoUCS.c"
		"Copyright (C) 2003" "*/")
	GargantuanAppendNoticeExcerpt("${SdlNotice}" "SunPro fdlibm" "${Sdl}/src/libm/e_atan2.c"
		"Copyright (C) 1993" "*/")
	GargantuanAppendNoticeExcerpt("${SdlNotice}" "stb_image" "${Sdl}/src/video/stb_image.h"
		"ALTERNATIVE A - MIT License" "ALTERNATIVE B - Public Domain")
	string(REPLACE "|" ";" SdlFeatures "${GARGANTUAN_SDL_NOTICE_FEATURES}")
	if("HIDAPI" IN_LIST SdlFeatures)
		file(READ "${Sdl}/src/hidapi/LICENSE-orig.txt" Hidapi)
		file(APPEND "${SdlNotice}" "\n\nHIDAPI – original license\n${Hidapi}\n")
	endif()
	if("OPENGL" IN_LIST SdlFeatures OR "OPENGLES" IN_LIST SdlFeatures)
		GargantuanAppendNoticeExcerpt("${SdlNotice}" "Mesa OpenGL API" "${Sdl}/include/SDL3/SDL_opengl.h"
			"Mesa 3-D graphics library" "*/")
		GargantuanAppendNoticeExcerpt("${SdlNotice}" "Khronos platform headers" "${Sdl}/src/video/khronos/KHR/khrplatform.h"
			"Copyright (c) 2008-2018" "*/")
		GargantuanAppendNoticeExcerpt("${SdlNotice}" "OpenGL registry headers" "${Sdl}/include/SDL3/SDL_opengl_glext.h"
			"Copyright 2013-2020" "*/")
	endif()
	if("VULKAN" IN_LIST SdlFeatures OR "OPENGLES" IN_LIST SdlFeatures)
		file(READ "${GARGANTUAN_SOURCE_DIR}/vendor/manifold/LICENSE" Apache)
		file(APPEND "${SdlNotice}" "\nKhronos EGL and Vulkan registry headers. Copyright 2007–2024 The Khronos Group Inc.\n${Apache}\n")
	endif()
	set(FreeType "${GARGANTUAN_SOURCE_DIR}/vendor/sdl_ttf/external/freetype")
	set(HarfBuzz "${GARGANTUAN_SOURCE_DIR}/vendor/sdl_ttf/external/harfbuzz")
	set(TextNotice "${Directory}/SDL3_ttf.txt")
	foreach(Driver bdf pcf)
		file(READ "${FreeType}/src/${Driver}/README" DriverReadme)
		string(FIND "${DriverReadme}" "\nLicense\n" Start)
		if(Start LESS 0)
			message(FATAL_ERROR "Review the updated FreeType ${Driver} license")
		endif()
		string(SUBSTRING "${DriverReadme}" ${Start} -1 DriverLicense)
		file(APPEND "${TextNotice}" "\nFreeType ${Driver} driver\n${DriverLicense}\n")
	endforeach()
	GargantuanAppendNoticeExcerpt("${TextNotice}" "FreeType hash implementation" "${FreeType}/src/base/fthash.c"
		"Copyright 2000 Computing" "*/")
	file(READ "${HarfBuzz}/src/ms-use/COPYING" Use)
	file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/notices/Unicode-Data.txt" Unicode)
	file(APPEND "${TextNotice}" "\nMicrosoft Universal Shaping Engine data in HarfBuzz generated tables\n${Use}\n"
		"Unicode Character Database 15.1.0 and Emoji 15.1 data, © 2023 Unicode, Inc.\n${Unicode}\n")
	set(FtOptions "${GARGANTUAN_BINARY_DIR}/vendor/sdl_ttf/external/freetype-build/include/freetype/config/ftoption.h")
	if(EXISTS "${FtOptions}")
		file(READ "${FtOptions}" Options)
		if(Options MATCHES "\n#define FT_CONFIG_OPTION_USE_ZLIB" AND NOT Options MATCHES "\n#define FT_CONFIG_OPTION_SYSTEM_ZLIB")
			GargantuanAppendNoticeExcerpt("${TextNotice}" "FreeType bundled zlib" "${FreeType}/src/gzip/zlib.h"
				"version 1.3.1" "The data format used")
		endif()
		if(Options MATCHES "\n#define FT_CONFIG_OPTION_USE_HARFBUZZ")
			GargantuanAppendNoticeExcerpt("${TextNotice}" "FreeType / HarfBuzz font integration" "${FreeType}/src/autofit/ft-hb.c"
				"Copyright ©" "*/")
		endif()
	elseif(GARGANTUAN_EXTERNAL_DISTRIBUTION)
		message(FATAL_ERROR "External staging requires the configured FreeType build header: ${FtOptions}")
	endif()
	set(Image "${GARGANTUAN_SOURCE_DIR}/vendor/sdl_image")
	file(COPY_FILE "${Image}/LICENSE.txt" "${Directory}/SDL3_image.txt")
	string(REPLACE "|" ";" Codecs "${GARGANTUAN_IMAGE_NOTICE_CODECS}")
	if("GIF" IN_LIST Codecs)
		GargantuanAppendNoticeExcerpt("${Directory}/SDL3_image.txt" "XPaint GIF decoder" "${Image}/src/IMG_gif.c"
			"/*        Some parts of the code" "/* Adapted for use")
	endif()
	if("QOI" IN_LIST Codecs)
		GargantuanAppendNoticeExcerpt("${Directory}/SDL3_image.txt" "QOI codec" "${Image}/src/qoi.h"
			"-- LICENSE: The MIT License" "-- About")
	endif()
	if("SVG" IN_LIST Codecs)
		GargantuanAppendNoticeExcerpt("${Directory}/SDL3_image.txt" "NanoSVG" "${Image}/src/nanosvg.h"
			"Copyright (c)" "*/")
	endif()
	if("BACKEND_STB" IN_LIST Codecs)
		GargantuanAppendNoticeExcerpt("${Directory}/SDL3_image.txt" "stb_image" "${Image}/src/stb_image.h"
			"ALTERNATIVE A - MIT License" "ALTERNATIVE B - Public Domain")
	endif()
	if("JPG_SAVE" IN_LIST Codecs)
		GargantuanAppendNoticeExcerpt("${Directory}/SDL3_image.txt" "Tiny JPEG Encoder" "${Image}/src/tiny_jpeg.h"
			"Tiny JPEG Encoder" "*/")
	endif()
	if(GARGANTUAN_GNS_LICENSE_FILE)
		file(COPY_FILE "${GARGANTUAN_GNS_LICENSE_FILE}" "${Directory}/GameNetworkingSockets.txt")
		if(GARGANTUAN_PLATFORM MATCHES "^Windows-" AND GARGANTUAN_GNS_REFERENCE_DONNA)
			get_filename_component(Gns "${GARGANTUAN_GNS_LICENSE_FILE}" DIRECTORY)
			foreach(Component curve25519-donna ed25519-donna)
				file(READ "${Gns}/src/external/${Component}/readme_VALVE.txt" Credit)
				file(APPEND "${Directory}/GameNetworkingSockets.txt" "\n\n${Component}\n\n${Credit}\n")
			endforeach()
		endif()
	endif()
endfunction()
