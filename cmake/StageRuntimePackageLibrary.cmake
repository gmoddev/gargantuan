cmake_minimum_required(VERSION 3.25)

if(GARGANTUAN_RUNTIME_PACKAGE_OPENSSL_DLL)
	if(NOT EXISTS "${GARGANTUAN_RUNTIME_PACKAGE_OPENSSL_DLL}")
		message(FATAL_ERROR "The configured OpenSSL runtime DLL is unavailable")
	endif()
	get_filename_component(DllName "${GARGANTUAN_RUNTIME_PACKAGE_OPENSSL_DLL}" NAME)
	file(MAKE_DIRECTORY "${GARGANTUAN_RUNTIME_PACKAGE_APP_LOCAL}")
	file(COPY_FILE "${GARGANTUAN_RUNTIME_PACKAGE_OPENSSL_DLL}"
		"${GARGANTUAN_RUNTIME_PACKAGE_APP_LOCAL}/${DllName}" ONLY_IF_DIFFERENT)
endif()
