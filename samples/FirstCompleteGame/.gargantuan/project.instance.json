"UDim2":[0.0,110,0.0,142]},"AutomaticSize":{"EnumItem":["AutomaticSize","None"]},"BackgroundColor3":{"Color3":[0.07999999821186066,0.47999998927116394,0.6200000047683716]},"InputSink":{"EnumItem":["InputSink","Activate"]},"ClipsDescendants":{"Bool":true},"Interactable":{"Bool":true},"LayoutOrder":{"Int":0},"Selectable":{"Bool":true},"Size":{"UDim2":[0.0,180,0.0,48]},"Visible":{"Bool":true},"ZIndex":{"Int":0},"AccessibilityRole":{"EnumItem":["AccessibilityRole","Automatic"]},"Opacity":{"Float":1.0},"AccessibilitySelected":{"Bool":false},"AccessibleName":{"String":"Restart collection round"}},"Attributes":{},"Extensions":[],"CustomProperties":[],"Tags":[],"Children":[]}]}]},{"Name":"GameScripts","ClassName":"Folder","ClassSchemaId":"dfa3ba4ea6909035cee5b32930b48871","ClassDefinitionVersion":1,"Properties":{},"Attributes":{},"Extensions":[],"CustomProperties":[],"Tags":[],"Children":[{"Name":"RoundManager","ClassName":"Script","ClassSchemaId":"c77fa1af2c8ca9d2e04f3d523d8cd7de","ClassDefinitionVersion":1,"Properties":{"Enabled":{"Bool":true},"RunContext":{"EnumItem":["RunContext","Client"]},"Source":{"String":"local Players = game:GetService(\"Players\")\nlocal ActionMap = game:GetService(\"ActionMap\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal Course = Workspace:FindFirstChild(\"CollectionCourse\")\nlocal CollectibleFolder = Course and Course:FindFirstChild(\"Collectibles\")\nlocal MovingObstacle = Course and Course:FindFirstChild(\"MovingObstacle\")\nlocal CollectionGui = game:FindFirstChild(\"CollectionGui\")\nlocal Hud = CollectionGui and CollectionGui:FindFirstChild(\"Hud\")\nlocal Progress = Hud and Hud:FindFirstChild(\"Progress\")\nlocal WinPanel = CollectionGui and CollectionGui:FindFirstChild(\"WinPanel\")\nlocal RestartButton = WinPanel and WinPanel:FindFirstChild(\"RestartButton\")\n\nif not (CollectibleFolder and MovingObstacle and Progress and WinPanel and RestartButton) then\n\terror(\"[Game:FirstCompleteGame] Authored hierarchy is incomplete\")\nend\n\nlocal Collectibles = CollectibleFolder:GetChildren()\nlocal Collected = {}\nlocal Count = 0\nlocal Elapsed = 0\n\nlocal function UpdateHud()\n\tProgress.Text = \"Collected \" .. tostring(Count) .. \" / \" .. tostring(#Collectibles)\n\tWinPanel.Visible = Count == #Collectibles\nend\n\nlocal function Collect(Item)\n\tif Collected[Item] then\n\t\treturn\n\tend\n\tCollected[Item] = true\n\tItem.Transparency = 1\n\tCount += 1\n\tUpdateHud()\n\tprint(\"[Game:FirstCompleteGame] Collected\", Item.Name, Count)\n\tif Count == #Collectibles then\n\t\tprint(\"[Game:FirstCompleteGame] Round complete\")\n\tend\nend\n\nlocal function ResetRound()\n\ttable.clear(Collected)\n\tCount = 0\n\tfor _, Item in Collectibles do\n\t\tItem.Transparency = 0\n\tend\n\tlocal LocalPlayer = Players.LocalPlayer\n\tlocal Character = LocalPlayer and LocalPlayer.Character\n\tif Character then\n\t\tCharacter.Position = Vector3.new(0, 6, 0)\n\t\tCharacter.Velocity = Vector3.zero\n\tend\n\tUpdateHud()\n\tprint(\"[Game:FirstCompleteGame] Round reset\")\nend\n\nlocal RestartConnection = RestartButton.Activated:Connect(ResetRound)\nlocal CompleteBinding = ActionMap:BindKey(\"CompleteRound\", Enum.KeyCode.K, 1, 100, false)\nlocal ActionConnection = ActionMap.ActionBegan:Connect(function(ActionName)\n\tif ActionName == \"CompleteRound\" then\n\t\tfor _, Item in Collectibles do\n\t\t\tCollect(Item)\n\t\tend\n\tend\nend)\n\nlocal SimulationConnection = RunService.PreSimulation:Connect(function(DeltaTime)\n\tElapsed += DeltaTime\n\tMovingObstacle.CFrame = CFrame.new(math.sin(Elapsed * 0.85) * 5, 1, -4)\n\tlocal LocalPlayer = Players.LocalPlayer\n\tlocal Character = LocalPlayer and LocalPlayer.Character\n\tif not Character then\n\t\treturn\n\tend\n\tfor _, Item in Collectibles do\n\t\tif not Collected[Item] and (Character.Position - Item.Position).Magnitude <= 2.25 then\n\t\t\tCollect(Item)\n\t\tend\n\tend\nend)\n\nscript.Destroying:Connect(function()\n\tSimulationConnection:Disconnect()\n\tActionConnection:Disconnect()\n\tActionMap:Unbind(CompleteBinding)\n\tRestartConnection:Disconnect()\nend)\n\nUpdateHud()\nprint(\"[Game:FirstCompleteGame] Ready\", #Collectibles)"}},"Attributes":{},"Extensions":[],"CustomProperties":[],"Tags":[],"Children":[]}]}],"Version":4}