include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/CreatorMicrosoftRuntime.cmake")
function(GargantuanVerifyRuntimeNotices Package)
	if(EXISTS "${Package}/GargantuanPlayer.exe" OR EXISTS "${Package}/GargantuanServer.exe")
		file(READ "${Package}/notices/MSVC-Runtime.txt" Prerequisite)
		if(NOT Prerequisite MATCHES "requires version 14[.][0-9]+[.][0-9]+" OR
			NOT Prerequisite MATCHES "learn.microsoft.com/en-us/cpp/windows/latest-supported-vc-redist")
			message(FATAL_ERROR "Windows export lacks its centrally serviced runtime prerequisite")
		endif()
		file(GLOB_RECURSE Entries LIST_DIRECTORIES false RELATIVE "${Package}" "${Package}/*")
		foreach(Entry IN LISTS Entries)
			string(TOLOWER "${Entry}" Name)
			if(Name MATCHES "${GargantuanMicrosoftRuntimePattern}")
				message(FATAL_ERROR "App-local Microsoft runtime in creator export: ${Entry}")
			endif()
		endforeach()
	endif()
	file(READ "${Package}/notices/Gargantuan.txt" Engine)
	file(READ "${Package}/notices/SDL3_ttf.txt" TextStack)
	foreach(Marker "Matching covered source" "Mozilla Public License Version 2.0" "Exhibit B")
		string(FIND "${Engine}" "${Marker}" Index)
		if(Index LESS 0)
			message(FATAL_ERROR "Exported Engine notice lacks ${Marker}")
		endif()
	endforeach()
	foreach(Marker "The FreeType Project" "FreeType Project LICENSE" "HarfBuzz" "Roboto Regular" "END OF TERMS AND CONDITIONS")
		string(FIND "${TextStack}" "${Marker}" Index)
		if(Index LESS 0)
			message(FATAL_ERROR "Exported text-stack notice lacks ${Marker}")
		endif()
	endforeach()
endfunction()
