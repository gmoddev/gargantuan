cmake_minimum_required(VERSION 3.25)

foreach(Variable PACKAGER MODEL_TEST MISSION PLAYER_DISTRIBUTION SERVER_DISTRIBUTION SOURCE_PROJECT WORKSPACE_ROOT)
	if(NOT DEFINED ${Variable} OR NOT EXISTS "${${Variable}}")
		message(FATAL_ERROR "Missing Relay Rescue input ${Variable}")
	endif()
endforeach()

file(REAL_PATH "${WORKSPACE_ROOT}" WorkspaceRoot)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef Suffix)
set(Workspace "${WorkspaceRoot}/gas-relay-${Suffix}")
if(EXISTS "${Workspace}")
	message(FATAL_ERROR "Relay Rescue qualification workspace is already in use")
endif()
file(MAKE_DIRECTORY "${Workspace}")

function(Run Label)
	execute_process(COMMAND "${CMAKE_COMMAND}" -E time ${ARGN}
		WORKING_DIRECTORY "${Workspace}"
		RESULT_VARIABLE ExitCode OUTPUT_VARIABLE Output ERROR_VARIABLE Error TIMEOUT 75)
	if(NOT "${ExitCode}" STREQUAL "0")
		message(FATAL_ERROR "[GAS:Relay] ${Label} failed (${ExitCode})\n${Output}${Error}")
	endif()
	message(STATUS "[GAS:Relay] ${Label}\n${Output}")
endfunction()

set(Origin "${Workspace}/Origin")
set(Json "${Origin}/.gargantuan/project.instance.json")
set(Place "${Workspace}/Relay.gasp")
set(Player "${Workspace}/Player")
set(Server "${Workspace}/Server")
set(Distributed "${Workspace}/DP")
file(COPY "${SOURCE_PROJECT}/" DESTINATION "${Origin}")
file(WRITE "${Origin}/.gargantuan/package-audience.json" "{\"Version\":1,\"SharedAssets\":[]}")
execute_process(COMMAND "${PACKAGER}" build --project "${Origin}" --output "${Distributed}"
	--runtime "${PLAYER_DISTRIBUTION}" --audiece DistributedPlayer
	RESULT_VARIABLE AudienceUsageExit OUTPUT_QUIET ERROR_QUIET TIMEOUT 15)
if(NOT "${AudienceUsageExit}" STREQUAL "2" OR EXISTS "${Distributed}")
	message(FATAL_ERROR "Unrecognized audience option did not stop before package construction")
endif()
file(SHA256 "${Json}" SourceDigest)
message(STATUS "[GAS:Relay] source JSON SHA-256 ${SourceDigest}")
Run(Export "${PACKAGER}" export-gasp --project "${Origin}" --output "${Place}")
file(SHA256 "${Place}" PlaceDigest)
file(RENAME "${Json}" "${Workspace}/Original.json")
Run(GaspPlayerBuild "${PACKAGER}" build --project "${Origin}" --gasp "${Place}" --output "${Player}"
	--runtime "${PLAYER_DISTRIBUTION}")
Run(GaspServerBuild "${PACKAGER}" build --project "${Origin}" --gasp "${Place}" --output "${Server}"
	--runtime "${SERVER_DISTRIBUTION}")
if(GNS)
	Run(DistributedGaspBuild "${PACKAGER}" build --project "${Origin}" --gasp "${Place}" --output "${Distributed}"
		--runtime "${PLAYER_DISTRIBUTION}" --audience DistributedPlayer)
	Run(DistributedValidation "${PACKAGER}" validate "${Distributed}" --audience DistributedPlayer)
	file(SHA256 "${Distributed}/game.package.json" DistributedDigest)
	file(READ "${Distributed}/content/client-code.json" DistributedCode)
	if(NOT DistributedCode MATCHES "RelayClient" OR DistributedCode MATCHES "RelayServer" OR
		EXISTS "${Distributed}/content/game.instance.json" OR EXISTS "${Distributed}/content/content.manifest.json" OR
		EXISTS "${Distributed}/content/prerun.luau" OR EXISTS "${Distributed}/content/regions")
		message(FATAL_ERROR "Distributed Relay Player artifact did not contain only the expected client startup data")
	endif()
endif()
Run(PlayerPackageIntegrity "${PACKAGER}" validate "${Player}")
Run(ServerPackageIntegrity "${PACKAGER}" validate "${Server}")
file(SHA256 "${Player}/game.package.json" PlayerDigest)
file(SHA256 "${Server}/game.package.json" ServerDigest)
message(STATUS "[GAS:Relay] player/server manifest SHA-256 ${PlayerDigest} ${ServerDigest}")

if(WIN32)
	set(ExecutableSuffix ".exe")
endif()
Run(PlayerStartup "${Player}/GargantuanPlayer${ExecutableSuffix}" --headless --startup-smoke)
Run(ServerStartup "${Server}/GargantuanServer${ExecutableSuffix}" --startup-smoke --max-ticks 12)
Run(GaspSimulatedMission "${MISSION}" --project "${Origin}" --gasp "${Place}")
if(GNS)
	Run(GaspRealGnsMission "${MISSION}" --gns --project "${Origin}" --gasp "${Place}")
endif()
Run(Restore "${PACKAGER}" restore-gasp --project "${Origin}" --gasp "${Place}")
Run(Reexport "${PACKAGER}" export-gasp --project "${Origin}" --output "${Workspace}/Restored.gasp")
file(SHA256 "${Workspace}/Restored.gasp" RestoredDigest)
if(NOT "${PlaceDigest}" STREQUAL "${RestoredDigest}")
	message(FATAL_ERROR "Restoring Relay Rescue changed its canonical GASP bytes")
endif()
message(STATUS "[GAS:Relay] equal export and re-export SHA-256 ${PlaceDigest}")
Run(JsonPlayerBuild "${PACKAGER}" build --project "${Origin}" --output "${Player}"
	--runtime "${PLAYER_DISTRIBUTION}")
Run(JsonServerBuild "${PACKAGER}" build --project "${Origin}" --output "${Server}"
	--runtime "${SERVER_DISTRIBUTION}")
if(GNS)
	Run(DistributedJsonBuild "${PACKAGER}" build --project "${Origin}" --output "${Distributed}"
		--runtime "${PLAYER_DISTRIBUTION}" --audience DistributedPlayer)
	file(SHA256 "${Distributed}/game.package.json" JsonDistributedDigest)
	if(NOT "${DistributedDigest}" STREQUAL "${JsonDistributedDigest}")
		message(FATAL_ERROR "Equivalent GAS and JSON did not build the same distributed Player manifest")
	endif()
endif()
file(SHA256 "${Player}/game.package.json" JsonPlayerDigest)
file(SHA256 "${Server}/game.package.json" JsonServerDigest)
if(NOT "${PlayerDigest}" STREQUAL "${JsonPlayerDigest}" OR
	NOT "${ServerDigest}" STREQUAL "${JsonServerDigest}")
	message(FATAL_ERROR "Equivalent GAS and JSON did not build the same role package manifests")
endif()
message(STATUS "[GAS:Relay] JSON and GASP built matching player/server manifests")
Run(AnimatedGasm "${MODEL_TEST}" --model-fixture "${Origin}" RelayBeacon)

file(REAL_PATH "${Workspace}" Resolved)
if(NOT "${Resolved}" STREQUAL "${Workspace}")
	message(FATAL_ERROR "Relay Rescue workspace redirected during qualification")
endif()
file(REMOVE_RECURSE "${Resolved}")
