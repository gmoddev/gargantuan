{
  "SchemaId": "gargantuan.four-client-physical-readiness",
  "SchemaVersion": 1,
  "Roles": {
    "CLIENT": ["physical.client-start.v1", "physical.client-result.v1"],
    "SERVER": ["physical.server-run.v1"]
  },
  "States": ["staged", "client-live", "server-result", "complete"],
  "Transitions": [
    {"From": "staged", "To": "client-live", "Role": "CLIENT", "Capability": "physical.client-start.v1", "Response": "LIVE", "Parameters": [], "Timeout": 20},
    {"From": "client-live", "To": "server-result", "Role": "SERVER", "Capability": "physical.server-run.v1", "Response": "RESULT", "Parameters": [], "Timeout": 90},
    {"From": "server-result", "To": "complete", "Role": "CLIENT", "Capability": "physical.client-result.v1", "Response": "RESULT", "Parameters": [], "Timeout": 30}
  ],
  "Parameters": {},
  "RegistrationTimeout": 180,
  "ExecutionTimeout": 150,
  "Abort": "local-cleanup"
}
