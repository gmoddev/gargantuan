{
  "SchemaId": "gargantuan.four-client-control-preflight",
  "SchemaVersion": 1,
  "Roles": {
    "CLIENT": ["physical.control-client-start.v1", "physical.control-client-result.v1"],
    "SERVER": ["physical.control-server-run.v1"]
  },
  "States": ["staged", "client-live", "server-result", "complete"],
  "Transitions": [
    {"From": "staged", "To": "client-live", "Role": "CLIENT", "Capability": "physical.control-client-start.v1", "Response": "LIVE", "Parameters": [], "Timeout": 20},
    {"From": "client-live", "To": "server-result", "Role": "SERVER", "Capability": "physical.control-server-run.v1", "Response": "RESULT", "Parameters": [], "Timeout": 15},
    {"From": "server-result", "To": "complete", "Role": "CLIENT", "Capability": "physical.control-client-result.v1", "Response": "RESULT", "Parameters": [], "Timeout": 15}
  ],
  "Parameters": {},
  "RegistrationTimeout": 180,
  "ExecutionTimeout": 240,
  "Abort": "local-cleanup"
}
